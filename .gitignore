# Bulk data artifacts
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Vocab is a build artifact — built deterministically from the train split.
# Don't check it in: a stale smoke-run vocab would silently encode real moves
# to <UNK> when training on a larger corpus.
data/vocab.json

# Model checkpoints
checkpoints/*
!checkpoints/.gitkeep

# PGN dumps
*.pgn
*.pgn.zst

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# Experiment tracking
wandb/

# IDE / tooling
.vscode/
.idea/
.claude/
CLAUDE.md
*.swp

# OS
.DS_Store
Thumbs.db
